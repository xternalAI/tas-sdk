{
  "name": "@traceandscale/sdk",
  "version": "0.1.0",
  "description": "One TypeScript SDK for prompts, model calls, tracing and evals, with Braintrust, Langfuse and LangSmith as interchangeable backends.",
  "keywords": [
    "llm",
    "prompts",
    "prompt-management",
    "tracing",
    "observability",
    "evals",
    "opentelemetry",
    "braintrust",
    "langfuse",
    "langsmith",
    "litellm",
    "vendor-neutral"
  ],
  "license": "MIT",
  "homepage": "https://github.com/xternalAI/tas-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xternalAI/tas-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/xternalAI/tas-sdk/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@12.21.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "tas": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cleanup:live": "node scripts/cleanup-live.ts",
    "test:live": "TAS_LIVE=1 vitest run test/braintrust.live.test.ts test/langfuse.live.test.ts test/langsmith.live.test.ts test/gateway.live.test.ts test/trace.live.test.ts test/eval.live.test.ts test/sync.live.test.ts test/datasets.live.test.ts test/migrate.live.test.ts",
    "coverage": "vitest run --coverage",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "lint": "biome check",
    "format": "biome check --write",
    "tas": "node src/bin.ts",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm lint && pnpm typecheck && pnpm coverage"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "typebox": "^1.4.7",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/context-async-hooks": "^3.1.1",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
