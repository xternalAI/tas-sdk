{
  "name": "@traceandscale/sdk",
  "version": "0.0.0",
  "private": true,
  "description": "Vendor-neutral prompts, tracing and evals over Langfuse, LangSmith, Braintrust and friends.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "tas": "./src/bin.ts"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cleanup:live": "node scripts/cleanup-live.ts",
    "test:live": "TAS_LIVE=1 vitest run test/braintrust.live.test.ts test/langfuse.live.test.ts test/langsmith.live.test.ts test/gateway.live.test.ts test/trace.live.test.ts test/eval.live.test.ts test/sync.live.test.ts test/datasets.live.test.ts",
    "coverage": "vitest run --coverage",
    "build": "rm -rf dist && tsc -p tsconfig.build.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "bin": {
      "tas": "./dist/bin.js"
    }
  },
  "dependencies": {
    "typebox": "^1.4.7",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
